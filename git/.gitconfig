[user]
	email = mael.briantin@proton.me
	name = MaelBriantin
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMNojPQxauIQxqRwBWbv+ih62f/MnyJehsqvDVY+lQxV
[init]
	defaultBranch = main
[core]
	editor = nvim
	excludesfile = /Users/mael/.gitignore_global
[alias]
    st = status
    co = checkout
    cb = checkout -b
    sw = switch
    sc = switch -c
    ap = add --patch
    aa = add --all
    ca = commit --amend --no-edit
    cm = commit -m
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    ps = push
    pl = pull
    me = merge
    cl = clone
    df = diff
    br = branch
    ta = tag
    sh = show
    rb = rebase
    rs = reset
    cp = cherry-pick
[push]
    autoSetupRemote = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
