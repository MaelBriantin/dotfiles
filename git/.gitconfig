[user]
	email = mael.briantin@proton.me
	name = Maël Briantin
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINDtGpUupBgVimLhsol9dlp5y00wAbhZiW/j8NR7R5eg
[init]
	defaultBranch = main
[core]
	editor = nvim
	excludesfile = /Users/mael/.gitignore_global
[alias]
    st = status
    co = checkout
    cb = checkout -b
    sw = switch
    sc = switch -c
    ap = add --patch
    aa = add --all
    ca = commit --amend --no-edit
    cm = commit -m
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    ps = push
    pl = pull
    me = merge
    cl = clone
    df = diff
    br = branch
    ta = tag
    sh = show
    rb = rebase
    rs = reset
    cp = cherry-pick
    # Hunk comme pager, à la demande (git normal sinon)
    hdiff = -c core.pager=\"hunk pager\" diff
    hshow = -c core.pager=\"hunk pager\" show
[push]
    autoSetupRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
